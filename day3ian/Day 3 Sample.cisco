D1:
conf t
vlan 10
name Concentrix
exit
interface vlan 10
ip address 192.168.120.1 255.255.255.224
no shutdown
exit
ip dhcop pool Concentrix
ip dhcp excluded-address 192.168.120.1 192.168.120.2
default-router 192.168.120.1
domain-name Concentrix.com
dns-server 192.168.120.1
end

A2:
conf t
vlan 10
name Concentrix
exit
interface e1/0
switchport mode access
switchport access vlan 10
end

P2:
conf t
interface e1/0 
no shutdown
ip address dhcp
end
show ip interface brief | exclude unassigned