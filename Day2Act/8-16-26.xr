@A1
config terminal
interface vlan 101
name vlan101.com
exit
interface vlan 101
ip address 10.100.10.65 255.255.255.192
no shutdown

ip dhcp excluded-address 10.100.10.65 10.100.10.70
ip dhcp pool  vlan101.com
network 10.100.10.64 255.255.255.192 
default-router 10.100.10.65

interface e0/0
switchport mode access
switchport access vlan 101

@D1
config terminal
vlan 102
name vlan102.com
exit
interface vlan 102
ip address 10.100.10.129 255.255.255.224
no shutdown

ip dhcp excluded-address 10.100.10.129 10.100.10.131
ip dhcp pool  vlan102.com
network 10.100.10.128 255.255.255.224 
default-router 10.100.10.129

interface e1/0
switchport mode access
switchport access vlan 102
end


@S1:
configure terminal
interface e1/0
ip address dhcp 
no shutdown
end
bp


